# ------------------------------Main-------------------------------
# Postgres
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DBNAME=your_database_name
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Gmail
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_ADDRESS=your_gmail_address@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Environment
ENV=development

# RabbitMq
MQ_USER=your_mq_user
MQ_PASSWORD=your_mq_password
MQ_SERVER_PORT=5672
MQ_UI_PORT=15672
MQ_HOST=localhost

# Wireguard
WG_PRIVATE_KEY=your_wireguard_private_key

# Compose network overrides
SERVICES_SUBNET=172.25.0.0/24
SERVICES_GATEWAY=172.25.0.1
PG_SERVICE_IP=172.25.0.2
ADMINER_IP=172.25.0.4

# Bridge attach list (space-separated container:bridge:ipcidr triples)
ATTACH_SERVICES=postgres.kws.services:lxdbr0:172.30.0.100/24 adminer.kws.services:lxdbr0:172.30.0.101/24 dnsmasq_kws:lxdbr0:172.30.0.102/24


# ------------------------------Services-------------------------------
# Postgres
PG_SERVICE_USERNAME=pg_service_username
PG_SERVICE_PASSWORD=pg_service_password
PG_SERVICE_HOST=postgres.kws.services
PG_SERVICE_PORT=pg_service_port
PG_SERVICE_DB=pg_service_db
